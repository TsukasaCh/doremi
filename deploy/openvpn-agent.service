[Unit]
Description=OpenVPN Manager Host Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/openvpn-agent.env
ExecStart=/usr/bin/python3 /opt/openvpn-agent/agent.py
Restart=on-failure
RestartSec=3
# Agent needs root for easy-rsa / iptables
User=root
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
