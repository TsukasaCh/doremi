# ==== Dashboard backend config ====
PORT=8080
# Admin login for the dashboard (change these!)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
# Secret used to sign session cookies
SESSION_SECRET=please-change-this-to-a-long-random-string
# Optional "decoy" unlock code. If set, visitors see a neutral sign-in page and
# the real login only appears after this exact code is entered. Verified
# server-side (never sent to the browser). Leave empty to disable the decoy.
# Do NOT reuse your admin or VPN password here.
UNLOCK_CODE=

# ==== Agents ====
# OpenVPN server agent (runs on the OpenVPN box)
OPENVPN_AGENT_URL=http://10.10.10.101:9000
OPENVPN_AGENT_TOKEN=shared-secret-openvpn-agent

# Proxmox host agent (runs on the Proxmox host, manages iptables)
PROXMOX_AGENT_URL=http://10.10.10.1:9000
PROXMOX_AGENT_TOKEN=shared-secret-proxmox-agent

# ==== VPN network settings ====
# Subnet OpenVPN hands out to clients (used to allocate per-user static IPs via CCD)
VPN_SUBNET=10.8.0.0
VPN_NETMASK=255.255.255.0
# First usable static IP offset in the pool (avoid .1 server, .2 reserved)
VPN_POOL_START=10

# How often (minutes) the scheduler checks for expired users
EXPIRY_CHECK_INTERVAL_MIN=15

# ==== Bandwidth chart (host throughput on the dashboard) ====
# Which agent's host to measure: proxmox | openvpn
BANDWIDTH_AGENT=proxmox
# Interface to measure; empty = the host's default-route interface (e.g. vmbr0)
BANDWIDTH_IFACE=
# Sampling interval (seconds) and how long to keep history (hours)
BANDWIDTH_SAMPLE_SEC=20
BANDWIDTH_RETAIN_HOURS=6
