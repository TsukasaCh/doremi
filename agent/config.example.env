# Copy to /etc/openvpn-agent.env on the target host and edit.
# systemd loads this via EnvironmentFile=

# ---- shared ----
AGENT_LISTEN=0.0.0.0
AGENT_PORT=9000
# MUST match the token in the backend .env for this agent
AGENT_TOKEN=change-me-long-random
# openvpn | proxmox | both
ROLE=openvpn

# =========================================================
# OpenVPN server host (10.10.10.101)  -> ROLE=openvpn
# =========================================================
# Folder that contains the 'easyrsa' script AND the 'pki' directory
EASYRSA_DIR=/etc/openvpn/easy-rsa
# Optional: set only if your PKI is NOT at <EASYRSA_DIR>/pki
#EASYRSA_PKI=/etc/openvpn/easy-rsa/pki
OPENVPN_DIR=/etc/openvpn
CCD_DIR=/etc/openvpn/ccd
TA_KEY=/etc/openvpn/ta.key
CRL_DEST=/etc/openvpn/crl.pem
# tls-crypt | tls-auth | none  (match your server.conf)
TLS_MODE=tls-crypt
# values written into every client .ovpn
VPN_REMOTE=vpn.example.com
VPN_PORT=1194
VPN_PROTO=udp
VPN_CIPHER=AES-256-GCM

# =========================================================
# Proxmox host (10.10.10.1)  -> ROLE=proxmox
# =========================================================
IPTABLES_BIN=iptables
# interface the VPN clients arrive on, seen from the Proxmox host
VPN_IFACE=tun0
PARENT_CHAIN=VPN_ACL
HOOK_CHAIN=FORWARD
